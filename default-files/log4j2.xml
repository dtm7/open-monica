<?xml version="1.0" encoding="UTF-8"?>
<!-- shutdownHook is disabled because MoniCA shuts down logging itself, after
     the archivers have been flushed, so their shutdown messages are not lost -->
<Configuration name="MoniCA" status="WARN" shutdownHook="disable">
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <!-- Print the date in ISO 8601 format -->
      <PatternLayout pattern="%d %-5p %c - %m%n" />
    </Console>
  </Appenders>
  <Loggers>
    <Root level="debug">
      <AppenderRef ref="console" />
    </Root>
  </Loggers>
</Configuration>
